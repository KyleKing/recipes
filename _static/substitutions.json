{"apple-pie-spice":[{"key":"apple-pie-spice","amount":"1 Tbsp","name":"Apple Pie Spice","items":["2 tsp ground cinnamon","1/2 tsp ground nutmeg","1/4 tsp ground allspice","1/4 tsp ground cardamom"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Apple-Pie-Spice"}],"baking-powder":[{"key":"baking-powder","amount":"","name":"Baking Soda for 1 tsp Baking Powder","items":["1/4 tsp baking soda","1/2 tsp cream of tartar","1/4 tsp cornstarch or tapioca starch"],"note":"This mixture is single-acting, so it lifts on contact with liquid and nothing else. Bake the batter right away.","href":"/reference/baking_powder_baking_soda_substitutions.html#Baking-Soda-for-1-tsp-Baking-Powder"}],"baking-soda":[{"key":"baking-soda","amount":"","name":"Baking Powder for 1 tsp Baking Soda","items":["3 tsp baking powder"],"note":"Baking soda is about three times stronger, and that much powder can leave a bitter, salty edge. Working the other way around is the safer swap.","href":"/reference/baking_powder_baking_soda_substitutions.html#Baking-Powder-for-1-tsp-Baking-Soda"}],"brown-sugar":[{"key":"brown-sugar","amount":"1 cup","name":"Brown Sugar","items":["1 cup granulated sugar","1 Tbsp molasses"],"note":"Use 2 Tbsp molasses for dark brown sugar.","href":"/reference/ingredient_substitutions.html#1-cup-Brown-Sugar"}],"buttermilk":[{"key":"buttermilk","amount":"1 cup","name":"Buttermilk","items":["1 cup milk","1 Tbsp lemon juice or white vinegar"],"note":"Stir and let it sit 10 minutes until it thickens and curdles. Plain yogurt or sour cream thinned with milk works too.","href":"/reference/ingredient_substitutions.html#1-cup-Buttermilk"}],"cajun-seasoning":[{"key":"cajun-seasoning","amount":"1 Tbsp","name":"Cajun Seasoning","items":["1 tsp paprika","1/2 tsp garlic powder","1/2 tsp onion powder","1/2 tsp dried oregano","1/4 tsp dried thyme","1/4 tsp cayenne","1/4 tsp ground black pepper"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Cajun-Seasoning"}],"cake-flour":[{"key":"cake-flour","amount":"1 cup","name":"Cake Flour","items":["1 cup all-purpose flour with 2 Tbsp removed","2 Tbsp cornstarch"],"note":"Sift together twice.","href":"/reference/ingredient_substitutions.html#1-cup-Cake-Flour"}],"chili-powder":[{"key":"chili-powder","amount":"1 Tbsp","name":"Chili Powder","items":["2 tsp paprika","1 tsp ground cumin","1/4 tsp garlic powder","1/4 tsp dried oregano","Cayenne to taste"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Chili-Powder"}],"cornstarch":[{"key":"cornstarch","amount":"1 Tbsp","name":"Cornstarch","use":"for thickening","items":["2 Tbsp all-purpose flour"],"href":"/reference/ingredient_substitutions.html#1-Tbsp-Cornstarch-for-thickening"}],"curry-powder":[{"key":"curry-powder","amount":"1 Tbsp","name":"Curry Powder","items":["1.5 tsp ground turmeric","1 tsp ground coriander","1/2 tsp ground cumin","1/4 tsp ground ginger","Cayenne to taste"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Curry-Powder"}],"egg":[{"key":"egg","amount":"1","name":"Egg","use":"in baking","items":["1 Tbsp ground flaxseed with 3 Tbsp water, rested 5 minutes","Or 1/4 cup unsweetened applesauce"],"note":"Neither works where the egg is doing the structural work, as in a custard or a meringue.","href":"/reference/ingredient_substitutions.html#1-Egg-in-baking"}],"fresh-herbs":[{"key":"fresh-herbs","amount":"1 Tbsp","name":"Fresh Herbs","items":["1 tsp dried herbs"],"note":"Dried herbs want simmering time, so add them early and add fresh ones at the end.","href":"/reference/ingredient_substitutions.html#1-Tbsp-Fresh-Herbs"}],"heavy-cream":[{"key":"heavy-cream","amount":"1 cup","name":"Heavy Cream","use":"for cooking","items":["3/4 cup whole milk","1/4 cup melted butter"],"note":"This will not whip. Nothing substitutes for cream in whipped cream.","href":"/reference/ingredient_substitutions.html#1-cup-Heavy-Cream-for-cooking"}],"herbes-de-provence":[{"key":"herbes-de-provence","amount":"1 Tbsp","name":"Herbes de Provence","items":["1 tsp dried thyme","1 tsp dried savory or oregano","1/2 tsp dried rosemary","1/2 tsp dried marjoram","1/4 tsp dried lavender"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Herbes-de-Provence"}],"italian-seasoning":[{"key":"italian-seasoning","amount":"1 Tbsp","name":"Italian Seasoning","items":["1 tsp dried basil","1 tsp dried oregano","1/2 tsp dried thyme","1/2 tsp dried rosemary"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Italian-Seasoning"}],"poultry-seasoning":[{"key":"poultry-seasoning","amount":"1 Tbsp","name":"Poultry Seasoning","items":["1.5 tsp dried sage","1 tsp dried thyme","1/4 tsp dried marjoram","1/4 tsp ground black pepper"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Poultry-Seasoning"}],"pumpkin-pie-spice":[{"key":"pumpkin-pie-spice","amount":"1 Tbsp","name":"Pumpkin Pie Spice","items":["2 tsp ground cinnamon","1/2 tsp ground ginger","1/4 tsp ground nutmeg","1/4 tsp ground allspice or cloves"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Pumpkin-Pie-Spice"}],"self-rising-flour":[{"key":"self-rising-flour","amount":"1 cup","name":"Self-Rising Flour","items":["1 cup all-purpose flour","1.5 tsp baking powder","1/4 tsp salt"],"href":"/reference/ingredient_substitutions.html#1-cup-Self-Rising-Flour"}],"sour-cream":[{"key":"sour-cream","amount":"1 cup","name":"Sour Cream","items":["1 cup plain full-fat Greek yogurt"],"href":"/reference/ingredient_substitutions.html#1-cup-Sour-Cream"}],"taco-seasoning":[{"key":"taco-seasoning","amount":"1 Tbsp","name":"Taco Seasoning","items":["1.5 tsp chili powder","1 tsp ground cumin","1/2 tsp paprika","1/4 tsp garlic powder","1/4 tsp onion powder","1/4 tsp salt"],"href":"/reference/spice_blend_substitutions.html#1-Tbsp-Taco-Seasoning"}],"tomato-sauce":[{"key":"tomato-sauce","amount":"1 cup","name":"Tomato Sauce","items":["1/2 cup tomato paste","1/2 cup water"],"href":"/reference/ingredient_substitutions.html#1-cup-Tomato-Sauce"}]}